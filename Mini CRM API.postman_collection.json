							"pm.test(\"Имя сохранилось правильно\", function () {",
							"    pm.expect(client.name).to.eql(\"Иван Петров\");",
							"});",
							"",
							"pm.test(\"Сервер выдал id\", function () {",
							"    pm.expect(client.id).to.be.a(\"number\");",
							"});",
							"",
							"pm.collectionVariables.set(\"client_id\", client.id);"
